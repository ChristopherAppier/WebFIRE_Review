{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Streamlit: Run current file",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "-n",
        "webfire-review",
        "python",
        "-m",
        "streamlit",
        "run",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Streamlit: Run dashboard",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "-n",
        "webfire-review",
        "python",
        "-m",
        "streamlit",
        "run",
        "${workspaceFolder}/ref/test scripts/streamlit_dashboard.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
